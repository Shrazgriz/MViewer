<Window x:Class="MViewer.WReadMesh"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MViewer"
        mc:Ignorable="d"
        Title="{Binding Path=MeshFilePath}" Height="280" Width="320">
    <Window.Resources>
        <local:V3ToStringConverter x:Key="V3ToStringConverter"/>
    </Window.Resources>
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition MaxHeight="60"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Margin="8" Orientation="Vertical">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">线段宽度</Label>
                <TextBox Grid.Column="1" x:Name="TB_Thickness" Margin="2" HorizontalAlignment="Stretch"
             Text="{Binding Path=Thickness, Mode=TwoWay}"/>            
            </Grid>
            <ComboBox Margin="2" x:Name="LB_ColorMode" SelectedIndex="0" SelectionChanged="LB_ColorMode_SelectionChanged">
                <ComboBoxItem>单色</ComboBoxItem>
                <ComboBoxItem>X坐标</ComboBoxItem>
                <ComboBoxItem>Y坐标</ComboBoxItem>
                <ComboBoxItem>Z坐标</ComboBoxItem>
                <ComboBoxItem>纹理</ComboBoxItem>
            </ComboBox>
            <Button Margin="2" Click="BN_Color_Click" Height="30" Background="{Binding Path=MeshBrush}">
                调色板
            </Button>

        </StackPanel>
        <StackPanel Margin="10" Grid.ColumnSpan="2" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <Button x:Name="BN_OK" Margin="18 0" MinWidth="120" HorizontalAlignment="Stretch"
            Click="BN_OK_Click" IsDefault="True">
                确 定
            </Button>
            <Button x:Name="BN_Cancel" Margin="18 0" MinWidth="120" HorizontalAlignment="Stretch"
            Click="BN_Cancel_Click" IsCancel="True">
                取 消
            </Button>
        </StackPanel>
    </Grid>
</Window>
